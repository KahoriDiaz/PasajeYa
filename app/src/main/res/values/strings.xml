    <string name="privacy_title">Privacidad y datos</string>
    <string name="privacy_version">Versión %1$s</string>
    <string name="privacy_last_updated">Última actualización: 26 de octubre de 2026</string>
    <string name="privacy_intro">Esta política describe cómo PasajeYa! trata tus datos personales para el transporte público de Arequipa.</string>
    <string name="privacy_data_title">Datos que usamos</string>
    <string name="privacy_data_body">Usamos tu correo, nombres, apellidos, fecha de nacimiento y DNI para crear y proteger tu cuenta. En los viajes, el GPS del vehículo del operador se usa para calcular la distancia y la tarifa.</string>
    <string name="privacy_dni_title">Tu DNI</string>
    <string name="privacy_dni_body">El DNI se guarda como un hash con clave secreta en el servidor. Nunca se muestra a otros usuarios ni se dice en voz alta.</string>
    <string name="privacy_location_title">Ubicación</string>
    <string name="privacy_location_body">El pasajero no comparte su ubicación. La distancia del viaje se calcula con el GPS del vehículo del operador.</string>
    <string name="privacy_security_title">Seguridad</string>
    <string name="privacy_security_body">Solo puedes leer tu propio perfil. Los montos, roles y estados los escribe únicamente el servidor. Una cuenta mantiene una sola sesión activa.</string>
    <string name="privacy_rights_title">Tus derechos</string>
    <string name="privacy_rights_body">Puedes solicitar acceso, corrección o eliminación de tus datos personales por los canales oficiales de soporte de PasajeYa!.</string>
